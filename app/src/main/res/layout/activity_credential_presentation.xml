<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <include layout="@layout/toolbar_with_back" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/presentation_request"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/verifier_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/verifierName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verifier Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/requested_claims_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/requestedClaims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Requested claims will appear here"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/matched_credentials_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/matchedCredentialsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/noMatchingCredentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_matching_credentials"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/selective_disclosure_label"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:id="@+id/selectiveDisclosureLabel" />

            <LinearLayout
                android:id="@+id/selectiveDisclosureContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_weight="1"
                    android:text="@string/cancel"
                    android:backgroundTint="@color/cyan_30"
                    android:textColor="@color/ibm_black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="24dp"
                    android:letterSpacing="0.02"
                    android:elevation="4dp"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button" />

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_weight="1"
                    android:text="@string/share_credential"
                    android:backgroundTint="@color/ibm_blue"
                    android:textColor="@color/ibm_white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="24dp"
                    android:letterSpacing="0.02"
                    android:elevation="4dp"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="8dp"
                    style="@android:style/Widget.Material.Button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

