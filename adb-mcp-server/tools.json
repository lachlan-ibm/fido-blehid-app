[
  {
    "name": "adb_devices",
    "description": "List all connected Android devices with optional detailed information",
    "inputSchema": {
      "type": "object",
      "properties": {
        "long_output": {
          "type": "boolean",
          "description": "Include detailed device information",
          "default": false
        }
      }
    }
  },
  {
    "name": "adb_get_state",
    "description": "Get the current state of a device (offline, bootloader, device)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      }
    }
  },
  {
    "name": "adb_get_serialno",
    "description": "Get the serial number of the connected device",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      }
    }
  },
  {
    "name": "adb_wait_for_device",
    "description": "Wait for device to be in a specific state",
    "inputSchema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["device", "recovery", "rescue", "sideload", "bootloader", "disconnect"],
          "description": "State to wait for",
          "default": "device"
        },
        "transport": {
          "type": "string",
          "enum": ["usb", "local", "any"],
          "description": "Transport type",
          "default": "any"
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      }
    }
  },
  {
    "name": "adb_connect",
    "description": "Connect to a device via TCP/IP",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Host IP address or hostname"
        },
        "port": {
          "type": "integer",
          "description": "Port number",
          "default": 5555
        }
      },
      "required": ["host"]
    }
  },
  {
    "name": "adb_disconnect",
    "description": "Disconnect from a TCP/IP device",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Host IP address (optional, disconnects all if not specified)"
        },
        "port": {
          "type": "integer",
          "description": "Port number",
          "default": 5555
        }
      }
    }
  },
  {
    "name": "adb_tcpip",
    "description": "Restart adbd listening on TCP on specified port",
    "inputSchema": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "description": "Port number",
          "default": 5555
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      },
      "required": ["port"]
    }
  },
  {
    "name": "adb_usb",
    "description": "Restart adbd listening on USB",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      }
    }
  },
  {
    "name": "adb_pair",
    "description": "Pair with a device for secure TCP/IP communication",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Host IP address"
        },
        "port": {
          "type": "integer",
          "description": "Port number"
        },
        "pairing_code": {
          "type": "string",
          "description": "Pairing code"
        }
      },
      "required": ["host", "port", "pairing_code"]
    }
  },
  {
    "name": "adb_forward",
    "description": "Forward socket connections from local to remote",
    "inputSchema": {
      "type": "object",
      "properties": {
        "local": {
          "type": "string",
          "description": "Local socket specification (e.g., tcp:8080)"
        },
        "remote": {
          "type": "string",
          "description": "Remote socket specification (e.g., tcp:8080)"
        },
        "no_rebind": {
          "type": "boolean",
          "description": "Fail if already forwarded",
          "default": false
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      },
      "required": ["local", "remote"]
    }
  },
  {
    "name": "adb_forward_list",
    "description": "List all forward socket connections",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      }
    }
  },
  {
    "name": "adb_forward_remove",
    "description": "Remove a specific forward socket connection",
    "inputSchema": {
      "type": "object",
      "properties": {
        "local": {
          "type": "string",
          "description": "Local socket specification to remove"
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      },
      "required": ["local"]
    }
  },
  {
    "name": "adb_forward_remove_all",
    "description": "Remove all forward socket connections",
    "inputSchema": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      }
    }
  },
  {
    "name": "adb_reverse",
    "description": "Reverse socket connections from remote to local",
