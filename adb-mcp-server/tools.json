  {
    "name": "adb_push",
    "description": "Copy local files/directories to device",
    "inputSchema": {
      "type": "object",
      "properties": {
        "local_path": {
          "type": "string",
          "description": "Local file or directory path"
        },
        "remote_path": {
          "type": "string",
          "description": "Remote path on device"
        },
        "sync": {
          "type": "boolean",
          "description": "Only push files with different timestamps",
          "default": false
        },
        "compression": {
          "type": "string",
          "enum": ["any", "none", "brotli", "lz4", "zstd"],
          "description": "Compression algorithm"
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      },
      "required": ["local_path", "remote_path"]
    }
  },
  {
    "name": "adb_pull",
    "description": "Copy files/directories from device to local",
    "inputSchema": {
      "type": "object",
      "properties": {
        "remote_path": {
          "type": "string",
          "description": "Remote path on device"
        },
        "local_path": {
          "type": "string",
          "description": "Local destination path"
        },
        "preserve": {
          "type": "boolean",
          "description": "Preserve file timestamp and mode",
          "default": false
        },
        "compression": {
          "type": "string",
          "enum": ["any", "none", "brotli", "lz4", "zstd"],
          "description": "Compression algorithm"
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      },
      "required": ["remote_path", "local_path"]
    }
  },
  {
    "name": "adb_install",
    "description": "Install an APK on the device",
    "inputSchema": {
      "type": "object",
      "properties": {
        "apk_path": {
          "type": "string",
          "description": "Path to APK file"
        },
        "replace": {
          "type": "boolean",
          "description": "Replace existing application",
          "default": false
        },
        "grant_permissions": {
          "type": "boolean",
          "description": "Grant all runtime permissions",
          "default": false
        },
        "allow_test": {
          "type": "boolean",
          "description": "Allow test packages",
          "default": false
        },
        "allow_downgrade": {
          "type": "boolean",
          "description": "Allow version code downgrade",
          "default": false
        },
        "instant": {
          "type": "boolean",
          "description": "Install as instant app",
          "default": false
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      },
      "required": ["apk_path"]
    }
  },
  {
    "name": "adb_uninstall",
    "description": "Uninstall an app package from device",
    "inputSchema": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "description": "Package name (e.g., com.example.app)"
        },
        "keep_data": {
          "type": "boolean",
          "description": "Keep data and cache directories",
          "default": false
        },
        "device_serial": {
          "type": "string",
          "description": "Device serial number (optional)"
        }
      },
      "required": ["package"]
    }
  },
