<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Include the custom toolbar -->
    <include
        layout="@layout/toolbar_with_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- TabLayout for switching between Passkeys and Digital Credentials -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextColor="@android:color/darker_gray"
        app:tabSelectedTextColor="@color/colorPrimary"
        app:tabIndicatorColor="@color/colorPrimary" />

    <!-- ViewPager2 for tab content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Legacy views (hidden when tabs are active) -->
    <LinearLayout
        android:id="@+id/legacyLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:background="@android:color/white">

        <TextView
            android:id="@+id/credentialsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_a_credential"
            android:layout_marginBottom="16dp" />

        <ListView
            android:id="@+id/credentialsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="singleChoice"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/delete_selected_credential"
            android:backgroundTint="@color/cyan_30"
            android:textColor="@color/ibm_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingVertical="20dp"
            android:paddingHorizontal="24dp"
            android:letterSpacing="0.02"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:layout_marginTop="16dp"
            android:enabled="false"
            style="@android:style/Widget.Material.Button" />

        <TextView
            android:id="@+id/noCredentialsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_resident_credentials_found"
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</LinearLayout>

