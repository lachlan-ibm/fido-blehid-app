<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bluetooth permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Classic Bluetooth permissions for Android 11 and below -->
    <uses-permission android:name="android.permission.BLUETOOTH"
                     android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
                     android:maxSdkVersion="30" />

    <!-- Declare Classic Bluetooth feature -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Boot receiver permission -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Camera permissions for QR code scanning (Phase 1: QR Scanner Integration) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".AyeBleKeyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/test_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/test_icon_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="com.isfs.blekey.MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Server Activity-->
        <activity
            android:name="com.isfs.blekey.activity.ServerActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
        
        <!-- Register ManageActivity -->
        <activity
            android:name="com.isfs.blekey.activity.ManageActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
            
        <!-- Register ResidentCredentialsActivity -->
        <activity
            android:name="com.isfs.blekey.activity.ResidentCredentialsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
            
        <!-- Register CreatePasskeyActivity -->
        <activity
            android:name="com.isfs.blekey.activity.CreatePasskeyActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
            
        <!-- Register CredentialIssuanceActivity -->
        <activity
            android:name="com.isfs.blekey.activity.CredentialIssuanceActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
            
        <!-- Register CredentialPresentationActivity -->
        <activity
            android:name="com.isfs.blekey.activity.CredentialPresentationActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
            
        <!-- Register QRScannerActivity -->
        <activity
            android:name="com.isfs.blekey.activity.QRScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
            
        <!-- Deep Link Handler for QR Code Scanning -->
        <activity
            android:name="com.isfs.blekey.activity.CredentialHandlerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.NoActionBar">
            
            <!-- Credential Offer Deep Link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid-credential-offer" />
            </intent-filter>
            
            <!-- Presentation Request Deep Link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid4vp" />
            </intent-filter>
            
            <!-- Generic OpenID Deep Link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid" />
            </intent-filter>
        </activity>
            
        <!-- Notify when a device connects to the app -->
        <service
            android:name=".ForegroundNotificationService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- HID Foreground Service for persistent classic Bluetooth HID device -->
        <service
            android:name=".hidsvc.HIDForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Digital Credential Provider Service (Phase 4.2) -->
        <!-- Note: Full Credential Manager integration requires Android 14+ (API 34+) -->
        <service
            android:name=".credentials.DigitalCredentialProviderService"
            android:enabled="true"
            android:exported="false">
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/digital_credential_provider" />
        </service>

        <!-- Boot receiver to auto-start service on device boot and Bluetooth state changes -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>


</manifest>
