<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Include the custom toolbar -->
    <include
        layout="@layout/toolbar_with_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white">

    <!-- Server Status Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/cool_gray_10"
        android:padding="20dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <!-- Server Status Header with BT Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/serverStatusTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/server_status"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/ibm_black"
                android:letterSpacing="0.02" />

            <!-- Bluetooth Status Icon -->
            <ImageView
                android:id="@+id/btStatusIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/stat_sys_data_bluetooth"
                android:contentDescription="Bluetooth Status"
                android:tint="@color/device_connected" />
        </LinearLayout>

        <!-- Advanced configuration row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/adv_config_row_label"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/advancedConfigButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_cog"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/adv_config_button_desc"
                android:tint="@color/ibm_blue" />
        </LinearLayout>

        <TextView
            android:id="@+id/bleDeviceNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Bluetooth Devices Section -->
    <TextView
        android:id="@+id/connectedDevicesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/local_devices"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/noDevicesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_devices_connected"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/devicesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp"
        android:visibility="visible" />

    <!-- Authentication Challenge Section -->
    <LinearLayout
        android:id="@+id/authChallengeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E8F5E9"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/authChallengeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Authentication Challenge"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/authChallengeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A device is requesting authentication. Please verify your identity to continue."
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/requestTypeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request Type: Credential Create"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/requestOriginText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Origin: example.com"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/authenticateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Authenticate"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/cancelAuthButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Activity Log Section -->
    <TextView
        android:id="@+id/activityLogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activity Log"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/activityLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
