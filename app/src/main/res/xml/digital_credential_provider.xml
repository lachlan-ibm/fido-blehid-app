<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright IBM 2025, 2026
  
  Digital Credential Provider Configuration
  
  This file declares the credential types supported by the DigitalCredentialProviderService.
  It is referenced in AndroidManifest.xml as metadata for the service.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Digital Credential Support -->
    <credential-query>
        <credential-type>DigitalCredential</credential-type>
    </credential-query>
    
    <!-- OpenID4VP Support -->
    <credential-query>
        <credential-type>openid4vp</credential-type>
    </credential-query>
    
    <!-- SD-JWT-VC Format Support -->
    <credential-query>
        <credential-type>SD-JWT-VC</credential-type>
    </credential-query>
    
    <!-- Verifiable Credential Support -->
    <credential-query>
        <credential-type>VerifiableCredential</credential-type>
    </credential-query>
    
</credential-provider>

