<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Credential type icon -->
    <ImageView
        android:id="@+id/credentialIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Credential type icon"
        android:src="@drawable/data_privacy_key" />

    <!-- Credential details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Credential type -->
        <TextView
            android:id="@+id/credentialType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Driver's License"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- Issuer name -->
        <TextView
            android:id="@+id/issuerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="State DMV"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp" />

        <!-- Expiration and status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <!-- Expiration date -->
            <TextView
                android:id="@+id/expirationDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expires: 2028-12-31"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />

            <!-- Status indicator -->
            <TextView
                android:id="@+id/statusIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valid ✓"
                android:textSize="12sp"
                android:textColor="#4CAF50"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Associated passkey -->
        <TextView
            android:id="@+id/associatedPasskey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Passkey: example.com"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>

