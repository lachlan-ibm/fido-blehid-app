<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/credentialsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resident Credentials"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/credentialsDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a credential to manage"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/credentialsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp" />

    <Button
        android:id="@+id/manageButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Selected Credential"
        android:layout_marginTop="16dp"
        android:enabled="false" />

    <TextView
        android:id="@+id/noCredentialsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No resident credentials found on this device"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

</LinearLayout>

