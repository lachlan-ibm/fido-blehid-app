<?xml version="1.0" encoding="utf-8"?>
<!-- Uses Android's default secure policy (HTTPS only) -->
<network-security-config>
    <!-- Base configuration: HTTPS only, system certificates -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
