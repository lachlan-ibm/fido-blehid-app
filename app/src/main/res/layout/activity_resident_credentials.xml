<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Include the custom toolbar -->
    <include
        layout="@layout/toolbar_with_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white">

    <TextView
        android:id="@+id/credentialsDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_a_credential"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/credentialsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp" />

    <Button
        android:id="@+id/deleteButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_selected_credential"
        android:layout_marginTop="16dp"
        android:enabled="false" />

    <TextView
        android:id="@+id/noCredentialsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_resident_credentials_found"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

    </LinearLayout>
</LinearLayout>

