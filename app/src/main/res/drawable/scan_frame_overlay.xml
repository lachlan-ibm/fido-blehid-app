<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Semi-transparent background overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
        </shape>
    </item>
    
    <!-- Transparent center area for scan frame -->
    <item
        android:top="120dp"
        android:bottom="120dp"
        android:left="40dp"
        android:right="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- Corner brackets for scan frame -->
    <!-- Top-left corner -->
    <item
        android:top="120dp"
        android:left="40dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="4dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    <item
        android:top="120dp"
        android:left="40dp">
        <shape android:shape="rectangle">
            <size android:width="4dp" android:height="40dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    
    <!-- Top-right corner -->
    <item
        android:top="120dp"
        android:right="40dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="4dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    <item
        android:top="120dp"
        android:right="40dp">
        <shape android:shape="rectangle">
            <size android:width="4dp" android:height="40dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    
    <!-- Bottom-left corner -->
    <item
        android:bottom="120dp"
        android:left="40dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="4dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    <item
        android:bottom="120dp"
        android:left="40dp">
        <shape android:shape="rectangle">
            <size android:width="4dp" android:height="40dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    
    <!-- Bottom-right corner -->
    <item
        android:bottom="120dp"
        android:right="40dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="4dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    <item
        android:bottom="120dp"
        android:right="40dp">
        <shape android:shape="rectangle">
            <size android:width="4dp" android:height="40dp" />
            <solid android:color="@color/ibm_blue" />
        </shape>
    </item>
    
</layer-list>

